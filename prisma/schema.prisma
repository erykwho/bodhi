generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrackProvider {
  YOUTUBE
  SOUNDCLOUD
  DIRECT_AUDIO
  GOOGLE_DRIVE
}

enum SessionMode {
  TIMER
  TRACK
  BREATHING
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  name           String?
  image          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  favoriteTracks FavoriteTrack[]
  sessions       MeditationSession[]
  timerPresets   TimerPreset[]
}

model FavoriteTrack {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     TrackProvider
  url          String
  externalId   String
  title        String
  author       String?
  thumbnailUrl String?
  tags         String[]            @default([])
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sessions     MeditationSession[]

  @@unique([userId, provider, externalId])
  @@index([userId, position, createdAt])
}

model MeditationSession {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode               SessionMode
  trackId            String?
  track              FavoriteTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  trackTitle         String?
  trackProvider      TrackProvider?
  breathingPattern   String?
  plannedDurationSec Int?
  actualDurationSec  Int
  completed          Boolean        @default(true)
  note               String?
  startedAt          DateTime
  endedAt            DateTime       @default(now())
  createdAt          DateTime       @default(now())

  @@index([userId, endedAt])
}

model TimerPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
