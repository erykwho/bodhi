# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/bodhi?sslmode=require"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth 2.0 credentials (from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional native mobile OAuth client IDs (iOS/Android Google Sign-In & Sign in with Apple)
MOBILE_GOOGLE_IOS_CLIENT_ID=""
MOBILE_GOOGLE_ANDROID_CLIENT_ID=""
AUTH_APPLE_BUNDLE_ID="app.bodhi.meditation"
AUTH_APPLE_SERVICE_ID=""

# Optional comma-separated list of authorized Google/Apple account emails.
# Leave empty or unset to allow any Google/Apple account to sign in.
ALLOWED_EMAILS=""

# Optional Sentry error monitoring (enabled automatically when DSN is set)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG="bodhi-09"
SENTRY_PROJECT="bodhi"
SENTRY_AUTH_TOKEN=""
