# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/bodhi?sslmode=require"

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth 2.0 credentials (from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional comma-separated list of authorized Google account emails.
# Leave empty or unset to allow any Google account to sign in.
ALLOWED_EMAILS=""
